{
  "name": "codecast",
  "version": "0.1.0",
  "private": true,
  "description": "Local, narrated walkthroughs of real source code",
  "type": "module",
  "main": "dist/electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:electron": "install-electron",
    "schema": "esbuild packages/core/export-schema.ts --bundle --platform=node --format=cjs --outfile=dist/tools/export-schema.cjs && node dist/tools/export-schema.cjs && prettier --write schemas/*.json",
    "test:desktop": "playwright test --config=playwright.desktop.config.ts",
    "setup:tts": "node scripts/setup-tts.mjs",
    "test:tts": "python3 -m unittest discover -s services/tts/tests",
    "test:agents:live": "esbuild scripts/smoke-generation.ts --bundle --platform=node --format=cjs --outfile=dist/tools/smoke-generation.cjs && node dist/tools/smoke-generation.cjs",
    "test:podcast:self": "esbuild scripts/self-test-podcast.ts --bundle --platform=node --format=cjs --outfile=dist/tools/self-test-podcast.cjs && node dist/tools/self-test-podcast.cjs"
  },
  "dependencies": {
    "ignore": "^7.0.14",
    "lucide-react": "^1.62.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
